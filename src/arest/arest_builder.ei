import { Server } from "std.http"
import { Dispatchers, Dispatcher } from "std.coroutines"
import { RoutingBuilder } from ".arest.routing"
import { McpBuilder } from ".arest.mcp.mcp_builder"

type ArestBuilder(
    val port: Int,
    var running: Bool = true,
    var healthEnabled: Bool = false,
    var healthPath: String = "/health",
    val routingBuilder: RoutingBuilder = RoutingBuilder(),
    val mcpBuilder: McpBuilder = McpBuilder(),
    var workerDispatcher: Dispatcher = Dispatchers.Default,
    var server: Server? = null
) {

    fun dispatcher(disp: Dispatcher) {
        this.workerDispatcher = disp
    }

    fun health(path: String = "/health") {
        healthEnabled = true
        healthPath = path
    }

    fun routing(init: RoutingBuilder.() -> Void) {
        init(routingBuilder)
    }

    fun static(prefix: String, dir: String) {
        routingBuilder.static(prefix, dir)
    }

    fun mcp(init: McpBuilder.() -> Void) {
        init(mcpBuilder)
    }

    fun shutdown() {
        this.running = false
        if (this.server != null) {
            this.server!!.close()
        }
    }

}