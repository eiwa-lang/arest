import { RoutingBuilder } from ".arest.routing"
import { McpBuilder } from ".arest.mcp.mcp_builder"

type ArestBuilder(
    val port: Int,
    var running: Bool = true,
    val routingBuilder: RoutingBuilder = RoutingBuilder(),
    val mcpBuilder: McpBuilder = McpBuilder()
) {

    fun routing(init: RoutingBuilder.() -> Void) {
        init(routingBuilder)
    }

    fun static(prefix: String, dir: String) {
        routingBuilder.static(prefix, dir)
    }

    fun mcp(init: McpBuilder.() -> Void) {
        init(mcpBuilder)
    }

    fun shutdown() {
        running = false
    }

}