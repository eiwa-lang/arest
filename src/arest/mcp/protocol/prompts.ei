import { ServerConnection } from "std.http"

import { ArestBuilder } from ".arest.arest_builder"
import { JsonRpc } from "std.jsonrpc"
import { MutableList } from "std.collections"
import { McpPrompt } from ".arest.mcp.mcp_builder"
import { McpCall } from ".arest.mcp.mcp_call"
import { McpPromptEntry, McpPromptsResult, McpGetPromptResult } from ".arest.mcp.protocol.models"

object Prompts {

    fun list(conn: ServerConnection, rpc: JsonRpc, builder: ArestBuilder) {
        val promptsList = MutableList<McpPromptEntry>()
        var i = 0
        val prompts = builder.mcpBuilder.prompts
        while (i < prompts.size()) {
            val item = prompts.get(i)
            if (item is McpPrompt) {
                val prompt = item
                promptsList.add(McpPromptEntry(prompt.name))
            }
            i = i + 1
        }
        val result = McpPromptsResult(promptsList.freeze())
        conn.writeResponse(200, "application/json", rpc.response(result.toJson()))
    }

    fun get(conn: ServerConnection, rpc: JsonRpc, builder: ArestBuilder) {
        val name = rpc.argumentString("name")
        var i = 0
        val prompts = builder.mcpBuilder.prompts
        while (i < prompts.size()) {
            val item = prompts.get(i)
            if (item is McpPrompt) {
                val prompt = item
                if (prompt.name == name) {
                    val call = McpCall(builder, prompt.name, rpc.params.asObject())
                    prompt.handler(call)

                    val result = McpGetPromptResult(call.result, MutableList<String>().freeze())
                    conn.writeResponse(200, "application/json", rpc.response(result.toJson()))
                    return
                }
            }
            i = i + 1
        }
        conn.writeResponse(200, "application/json",
            rpc.errorResponse(-32602, "Prompt not found: $name"))
    }
}