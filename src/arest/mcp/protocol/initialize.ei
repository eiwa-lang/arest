import { ServerConnection } from "std.http"

import { ArestBuilder } from ".arest.arest_builder"
import { JsonRpc } from "std.jsonrpc"

object Initialize {

    fun execute(conn: ServerConnection, rpc: JsonRpc, builder: ArestBuilder) {
        val cfg = builder.mcpBuilder
        val result = "{\n" +
            "  \"protocolVersion\": \"2024-11-05\",\n" +
            "  \"capabilities\": {\n" +
            "    \"tools\": {},\n" +
            "    \"resources\": {},\n" +
            "    \"prompts\": {}\n" +
            "  },\n" +
            "  \"serverInfo\": {\n" +
            "    \"name\": \"" + cfg.serverName + "\",\n" +
            "    \"version\": \"" + cfg.serverVersion + "\"\n" +
            "  }\n" +
            "}"
        conn.writeResponse(200, "application/json", rpc.response(result))
    }
}