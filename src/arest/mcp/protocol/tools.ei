import { ServerConnection } from "std.http"

import { ArestBuilder } from ".arest.arest_builder"
import { JsonRpc } from "std.jsonrpc"
import { JsonValue, jsonObject, jsonArray, jsonString } from "std.json"
import { MutableList, MutableMap } from "std.collections"
import { McpTool, typeName } from ".arest.mcp.mcp_builder"
import { McpCall } from ".arest.mcp.mcp_call"
import { McpTextContent, McpCallResult } from ".arest.mcp.protocol.models"

object Tools {

    fun list(conn: ServerConnection, rpc: JsonRpc, builder: ArestBuilder) {
        val toolsJson = MutableList<JsonValue>()
        var i = 0
        val tools = builder.mcpBuilder.tools
        while (i < tools.size()) {
            val item = tools.get(i)
            if (item is McpTool) {
                val tool = item
                val properties = MutableMap<String, JsonValue>()
                val required = MutableList<JsonValue>()
                var j = 0
                while (j < tool.arguments.size()) {
                    val argument = tool.arguments.get(j)
                    val property = MutableMap<String, JsonValue>()
                    property.put("type", jsonString(typeName(argument.t)))
                    if (argument.description != "") {
                        property.put("description", jsonString(argument.description))
                    }
                    properties.put(argument.name, jsonObject(property.freeze()))
                    if (argument.required) {
                        required.add(jsonString(argument.name))
                    }
                    j = j + 1
                }

                val schema = MutableMap<String, JsonValue>()
                schema.put("type", jsonString("object"))
                schema.put("properties", jsonObject(properties.freeze()))
                schema.put("required", jsonArray(required.freeze()))

                val entry = MutableMap<String, JsonValue>()
                entry.put("name", jsonString(tool.name))
                if (tool.description != "") {
                    entry.put("description", jsonString(tool.description))
                }
                entry.put("inputSchema", jsonObject(schema.freeze()))

                toolsJson.add(jsonObject(entry.freeze()))
            }
            i = i + 1
        }

        val result = MutableMap<String, JsonValue>()
        result.put("tools", jsonArray(toolsJson.freeze()))
        conn.writeResponse(200, "application/json", rpc.response(jsonObject(result.freeze()).write()))
    }

    fun call(conn: ServerConnection, rpc: JsonRpc, builder: ArestBuilder) {
        val name = rpc.argumentString("name")
        var i = 0
        val tools = builder.mcpBuilder.tools
        while (i < tools.size()) {
            val item = tools.get(i)
            if (item is McpTool) {
                val tool = item
                if (tool.name == name) {
                    val argsVal = rpc.params.get("arguments")
                    val args = if (argsVal != null) argsVal!!.asObject() else Map<String, JsonValue>()
                    val call = McpCall(builder, tool.name, args)
                    tool.handler(call)

                    val text = McpTextContent("text", if (call.errorMessage != "") call.errorMessage else call.result)
                    val content = MutableList<McpTextContent>()
                    content.add(text)
                    val result = McpCallResult(content.freeze(), call.errorMessage != "")
                    conn.writeResponse(200, "application/json", rpc.response(result.toJson()))
                    return
                }
            }
            i = i + 1
        }
        conn.writeResponse(200, "application/json",
            rpc.errorResponse(-32602, "Tool not found: " + name))
    }
}