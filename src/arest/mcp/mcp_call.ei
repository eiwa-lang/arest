import { JsonValue } from "std.json"
import { Map } from "std.collections"
import { Stringable } from "std.core"
import { ArestBuilder } from ".arest.arest_builder"

type McpCall(
    val server: ArestBuilder,
    val tool: String = "",
    val arguments: Map<String, JsonValue> = Map<String, JsonValue>(),
    var result: String = "",
    var errorMessage: String = ""
) {

    fun respond(value: Stringable): String {
        val text = value.toString()
        this.result = text
        return text
    }

    fun error(message: Stringable): String {
        val text = message.toString()
        this.errorMessage = text
        return text
    }

    fun hasArgument(name: String): Bool {
        return this.arguments.containsKey(name)
    }
}