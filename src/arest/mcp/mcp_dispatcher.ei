import { ServerConnection, Request } from "std.http"

import { Log } from "std.log"

import { ArestBuilder } from ".arest.arest_builder"

import { JsonRpc } from "std.jsonrpc"
import { JsonValue } from "std.json"
import { Initialize } from ".arest.mcp.protocol.initialize"
import { Tools } from ".arest.mcp.protocol.tools"
import { Resources } from ".arest.mcp.protocol.resources"
import { Prompts } from ".arest.mcp.protocol.prompts"

type McpDispatcher(val builder: ArestBuilder) {

    fun dispatch(conn: ServerConnection, req: Request) {
        if (req.method != "POST") {
            val emptyRpc = JsonRpc(JsonValue(), "", JsonValue())
            conn.writeResponse(405, "application/json", emptyRpc.errorResponse(-32600, "Method Not Allowed"))
            Log.warn { "[Arest] HTTP ${req.method} ${req.path} -> 405 Method Not Allowed" }
            return
        }

        val rpc = JsonRpc.parse(req.body)
        when (rpc.method) {
            "initialize" -> Initialize.execute(conn, rpc, builder)
            "ping" -> {
                conn.writeResponse(200, "application/json", rpc.response("{}"))
                Log.info { "[Arest] MCP HTTP ${req.method} ${req.path} -> 200 OK" }
            }
            "tools/list" -> Tools.list(conn, rpc, builder)
            "tools/call" -> Tools.call(conn, rpc, builder)
            "resources/list" -> Resources.list(conn, rpc, builder)
            "resources/read" -> Resources.read(conn, rpc, builder)
            "prompts/list" -> Prompts.list(conn, rpc, builder)
            "prompts/get" -> Prompts.get(conn, rpc, builder)
            else -> {
                if (rpc.method.startsWith("notifications/")) {
                    conn.writeResponse(202, "application/json", "")
                    Log.info { "[Arest] MCP HTTP ${req.method} ${req.path} -> 202 OK" }
                } else {
                    conn.writeResponse(404, "application/json", rpc.errorResponse(-32601, "Method not found"))
                    Log.warn { "[Arest] MCP HTTP ${req.method} ${req.path} -> 404 Method not found" }
                }
            }
        }
    }
}
