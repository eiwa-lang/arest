import { ServerConnection, Request } from "std.http"
import { Serializable } from "std.serde"
import { NativeMemory } from "std.core"
import { MutableMap, MutableList } from "std.collections"
import { ArestBuilder } from ".arest.arest_builder"

type ApplicationCall(
    val conn: ServerConnection,
    val request: Request,
    val server: ArestBuilder,
    val pathParams: MutableMap<String, String> = MutableMap<String, String>(),
    val pendingHeaders: MutableList<String> = MutableList<String>()
) {

    // Queues a raw response header line (e.g. "HX-Redirect: /home").
    // Flushed with the next respond* call.
    fun responseHeader(name: String, value: String) {
        pendingHeaders.add("$name: $value")
    }

    // Queues a Set-Cookie header. `attrs` is appended verbatim
    // (e.g. "; HttpOnly; Path=/; Max-Age=600").
    fun setCookie(name: String, value: String, attrs: String = "") {
        pendingHeaders.add("Set-Cookie: $name=$value$attrs")
    }

    // Clears a cookie by expiring it immediately.
    fun clearCookie(name: String, path: String = "/") {
        setCookie(name, "", "; Path=$path; Max-Age=0")
    }

    // Reads a cookie from the Cookie request header. Returns null when absent.
    fun cookie(name: String): String? {
        val header = header("Cookie")
        if (header == null) {
            return null
        }
        val parts = header!!.split(";")
        var i = 0
        while (i < parts.size()) {
            val pair = parts.get(i).trim()
            if (pair.length > name.length + 1 && pair.substring(0, name.length + 1) == "$name=") {
                return pair.substring(name.length + 1, pair.length)
            }
            i = i + 1
        }
        return null
    }

    // 302 redirect with a Location header (htmx requests should use HX-Redirect instead).
    fun respondRedirect(url: String, status: Int = 302) {
        responseHeader("Location", url)
        respond("", status, "text/plain")
    }

    fun respond(body: String, status: Int, contentType: String) {
        conn.writeResponseWithHeaders(status, contentType, body, pendingHeaders.freeze())
    }

    fun respond(value: Serializable, status: Int = 200) {
        val body = server.negotiation.serialize(value)
        respond(body, status, server.negotiation.contentType())
    }

    fun <T> receive(): T {
        val serdeVal = this.server.negotiation.deserialize(this.request.body)
        return T.deserialize(serdeVal)
    }

    fun respondText(body: String, status: Int = 200) {
        respond(body, status, "text/plain")
    }

    fun respondHtml(body: String, status: Int = 200) {
        respond(body, status, "text/html")
    }

    fun respondJson(body: String, status: Int = 200) {
        respond(body, status, "application/json")
    }

    fun header(name: String): String? {
        val direct = request.headers.get(name)
        if (direct != null) {
            return direct
        }
        var i = 0
        val entries = request.headers.entries
        while (i < entries.size()) {
            var curr = entries.get(i)
            while (curr != null) {
                if (iequals(curr!!.key, name)) {
                    return curr!!.value
                }
                curr = curr!!.next
            }
            i = i + 1
        }
        return null
    }

    fun query(name: String): String? {
        return request.queries.get(name)
    }

    fun queryOrDefault(name: String, defaultVal: String): String {
        val v = request.queries.get(name)
        if (v != null) {
            return v!!
        }
        return defaultVal
    }

    // Returns the value of a path parameter extracted by the router.
    // e.g. for pattern "/users/:id" matched against "/users/42" -> pathParam("id") == "42"
    fun pathParam(name: String): String? {
        return pathParams.get(name)
    }

    fun iequals(a: String, b: String): Bool {
        if (a.length != b.length) {
            return false
        }
        var i = 0
        while (i < a.length) {
            var ca = NativeMemory.readByte(a.ptr!!, i)
            var cb = NativeMemory.readByte(b.ptr!!, i)
            if (ca >= 65 && ca <= 90) {
                ca = ca + 32
            }
            if (cb >= 65 && cb <= 90) {
                cb = cb + 32
            }
            if (ca != cb) {
                return false
            }
            i = i + 1
        }
        return true
    }
}
