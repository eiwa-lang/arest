import { Server, ServerConnection } from "std.http"
import { Log } from "std.log"

import { ArestBuilder } from ".arest.server.arest_builder"
import { RequestDispatcher } from ".arest.dispatcher.dispatcher"
import { HttpDispatcher } from ".arest.dispatcher.http_dispatcher"
import { McpDispatcher } from ".arest.mcp.mcp_dispatcher"

fun arest(port: Int, init: ArestBuilder.() -> Void) {
    val builder = ArestBuilder(port)
    init(builder)
    val server = Server()
    builder.server = server
    if (server.bind(port)) {
        Log.info { "[Arest] Server listening on http://localhost:$port ..." }
        val dispatcher = RequestDispatcher(builder, HttpDispatcher(builder), McpDispatcher(builder))
        val disp = builder.workerDispatcher
        while (builder.running) {
            try {
                val conn = server.accept()
                if (builder.running) {
                    if (conn is ServerConnection) {
                        task(disp) {
                            dispatcher.dispatch(conn)
                        }
                    }
                } else {
                    if (conn != null) {
                        conn!!.close()
                    }
                }
            } catch (e) {
                Log.error(e) { "[Arest] Error processing connection" }
            }
        }

        server.close()
        Log.info { "[Arest] Server stopped gracefully." }
    } else {
        Log.error { "[Arest] Failed to bind to port $port" }
    }
}
