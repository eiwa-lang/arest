import { Server, ServerConnection } from "std.http"
import { Log } from "std.log"
import { Scheduler } from "std.coroutines"

import { ArestBuilder } from ".arest.arest_builder"
import { Dispatcher } from ".arest.dispatcher.dispatcher"
import { HttpDispatcher } from ".arest.dispatcher.http_dispatcher"
import { McpDispatcher } from ".arest.mcp.mcp_dispatcher"

fun arest(port: Int, init: ArestBuilder.() -> Void) {
    val builder = ArestBuilder(port)
    init(builder)
    val server = Server()
    if (server.bind(port)) {
        Log.info { "[Arest] Server listening on http://localhost:" + port.toString() + " ..." }
        val dispatcher = Dispatcher(builder, HttpDispatcher(builder), McpDispatcher(builder))
        while (builder.running) {
            try {
                val conn = server.accept()
                if (conn is ServerConnection) {
                    task {
                        dispatcher.dispatch(conn)
                    }
                    // Stackless cooperative scheduler: a fire-and-forget `task {}`
                    // only runs when something drains the queue. The blocking-poll
                    // accept loop below never returns to the root to drain, so pump
                    // the scheduler right after scheduling the connection handler.
                    // Handlers are synchronous (blocking poll), so this runs each
                    // connection to completion before accepting the next one.
                    Scheduler.run()
                }
            } catch (e) {
                Log.error(e) { "[Arest] Error processing connection" }
            }
        }

        server.close()
        Log.info { "[Arest] Server stopped gracefully." }
    } else {
        Log.error { "[Arest] Failed to bind to port " + port.toString() }
    }
}
