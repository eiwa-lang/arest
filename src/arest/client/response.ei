import { Map } from "std.collections"
import { parseJson, JsonValue } from "std.json"
import { ContentNegotiation, JsonNegotiation } from ".arest.client.negotiation"

type HttpResponse(
    val status: Int,
    val rawBody: String,
    val headers: Map<String, String> = Map<String, String>(),
    val ok: Bool = status >= 200 && status < 300,
    val isClientError: Bool = status >= 400 && status < 500,
    val isServerError: Bool = status >= 500 && status < 600,
    val isNotFound: Bool = status == 404,
    val isUnauthorized: Bool = status == 401,
    val isForbidden: Bool = status == 403,
    var negotiation: ContentNegotiation = JsonNegotiation()
) {

    fun text(): String = this.rawBody
    fun body(): String = this.rawBody

    fun body<T>(): T {
        val serdeVal = this.negotiation.deserialize(this.rawBody)
        return T.deserialize(serdeVal)
    }

    fun body<T>(negotiation: ContentNegotiation): T {
        val serdeVal = negotiation.deserialize(this.rawBody)
        return T.deserialize(serdeVal)
    }

    fun json(): JsonValue {
        return parseJson(this.rawBody)
    }

    fun header(name: String): String? {
        return this.headers.get(name)
    }

    fun headerOrDefault(name: String, defaultVal: String): String {
        val h = this.header(name)
        if (h != null) {
            return h!!
        }
        return defaultVal
    }

    fun contentType(): String? {
        return this.header("Content-Type")
    }
}
