import { Serializable } from "std.serde"
import { serializeJson, fromJson } from "std.json"
import { ApplicationCall } from ".arest.application_call"
import { SignedCookie } from ".arest.signed_cookie"

// Typed session storage over cookies (Ktor Sessions equivalent).
//
// Two flavors:
// - signed sessions: SignedCookie v1 envelope (HMAC, tamper-proof)
// - plain sessions: raw JSON, for short-lived non-sensitive data (e.g. OAuth PKCE state)
//
// Crypto stays in the crypto lib; SignedCookie owns the signed envelope.
// This module only maps typed values <-> cookies with names and attributes.
object Sessions {

    fun <T> setSigned(call: ApplicationCall, name: String, value: T, secret: String, maxAge: Int = 2592000, path: String = "/", httpOnly: Bool = true, secure: Bool = true, sameSite: String = "Lax") {
        SignedCookie.setSignedCookie(call, name, value, secret, maxAge, path, httpOnly, secure, sameSite)
    }

    fun <T> getSigned(call: ApplicationCall, name: String, secret: String): T? {
        return SignedCookie.getSignedCookie<T>(call, name, secret)
    }

    fun <T> setPlain(call: ApplicationCall, name: String, value: T, maxAge: Int = 600, path: String = "/") {
        call.setCookie(name, serializeJson(value), "; Path=$path; Max-Age=$maxAge; HttpOnly")
    }

    fun <T> getPlain(call: ApplicationCall, name: String): T? {
        val raw = call.cookie(name)
        if (raw == null) {
            return null
        }
        try {
            return fromJson<T>(raw!!)
        } catch (e: Throwable) {
            return null
        }
    }

    fun clear(call: ApplicationCall, name: String, path: String = "/") {
        call.clearCookie(name, path)
    }
}
