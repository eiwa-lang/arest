import { ApplicationCall } from ".arest.server.application_call"
import { MutableList } from "std.collections"
import { Mutex, sync } from "std.thread"
import { sleepMs } from "std.time"

fun chunkSizeHex(value: Int): String {
    val digits = "0123456789abcdef"
    if (value == 0) {
        return "0"
    }
    var hex = ""
    var rest = value
    while (rest > 0) {
        val d = rest - (rest / 16) * 16
        hex = digits.substring(d, d + 1) + hex
        rest = rest / 16
    }
    return hex
}

type ApplicationSseCall(val call: ApplicationCall) {
    fun send(data: String, event: String? = null, id: String? = null) {
        Sse.sendChecked(this.call, Sse.format(data, event, id))
    }

    fun sendComment(comment: String) {
        Sse.sendChecked(this.call, ": $comment\n\n")
    }

    fun close() {
        Sse.close(this.call)
    }

    fun header(name: String): String? {
        return this.call.header(name)
    }

    fun query(name: String): String? {
        return this.call.query(name)
    }
}

// The block must return at once: looping here pins one worker per open
// stream and starves the pool. A block that closes skips subscribing;
// a block that throws closes instead of subscribing.
fun ApplicationCall.sse(init: ApplicationSseCall.() -> Void) {
    Sse.hijack(this)
    try {
        init(ApplicationSseCall(this))
        if (this.sseOpen) {
            Sse.subscribe(this)
        }
    } catch (e: Throwable) {
        Sse.close(this)
    }
}

type SseSubscription(val call: ApplicationCall)

object Sse {
    val lock: Mutex = Mutex()
    val writeLock: Mutex = Mutex()
    val subs: MutableList<SseSubscription> = MutableList<SseSubscription>()
    var pumpStarted: Bool = false
    var pumpRunning: Bool = true
    var heartbeatMs: Int = 14000

    fun hijack(call: ApplicationCall) {
        if (call.sseOpen) {
            throw Exception("sse hijack twice on the same connection")
        }
        var head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n"
        var i = 0
        while (i < call.pendingHeaders.size()) {
            head = head + call.pendingHeaders.get(i) + "\r\n"
            i = i + 1
        }
        head = head + "\r\n"
        call.conn.sock.write(head)
        call.sseOpen = true
    }

    // Clears sseOpen so sse { } skips subscribing a finished stream.
    fun close(call: ApplicationCall) {
        unsubscribe(call)
        call.conn.sock.write("0\r\n\r\n")
        call.conn.close()
        call.sseOpen = false
    }

    fun sendChecked(call: ApplicationCall, payload: String) {
        if (!sendTo(call, payload)) {
            throw Exception("SSE client disconnected")
        }
    }

    fun subscribe(call: ApplicationCall) {
        if (!call.sseOpen) {
            throw Exception("Sse.subscribe without sse hijack")
        }
        var start = false
        sync(Sse.lock) {
            Sse.subs.add(SseSubscription(call))
            if (!Sse.pumpStarted) {
                Sse.pumpStarted = true
                Sse.pumpRunning = true
                start = true
            }
            true
        }
        if (start) {
            task {
                while (Sse.pumpRunning) {
                    sleepMs(Sse.heartbeatMs)
                    Sse.heartbeat()
                }
            }
        }
    }

    fun unsubscribe(call: ApplicationCall) {
        sync(Sse.lock) {
            Sse.dropLocked(call.conn.sock.fd, true)
            true
        }
    }

    fun stop() {
        sync(Sse.lock) {
            Sse.pumpRunning = false
            Sse.pumpStarted = false
            true
        }
    }

    fun count(): Int {
        var n = 0
        sync(Sse.lock) {
            n = Sse.subs.size()
            true
        }
        return n
    }

    fun broadcast(data: String, event: String? = null, id: String? = null) {
        Sse.pushAll(Sse.format(data, event, id))
    }

    fun heartbeat() {
        Sse.pushAll(": hb\n\n")
    }

    fun format(data: String, event: String? = null, id: String? = null): String {
        var payload = ""
        if (event != null) {
            payload = payload + "event: ${event}\n"
        }
        if (id != null) {
            payload = payload + "id: ${id}\n"
        }
        payload = payload + "data: $data\n\n"
        return payload
    }

    // Returns false when the peer is gone.
    fun sendTo(call: ApplicationCall, payload: String): Bool {
        val frame = "${chunkSizeHex(payload.length)}\r\n$payload\r\n"
        var ok = false
        sync(Sse.writeLock) {
            val n = call.conn.sock.write(frame)
            ok = n == frame.length
            true
        }
        return ok
    }

    fun pushAll(payload: String) {
        val live: MutableList<SseSubscription> = MutableList<SseSubscription>()
        sync(Sse.lock) {
            var i = 0
            while (i < Sse.subs.size()) {
                live.add(Sse.subs[i])
                i = i + 1
            }
            true
        }
        var j = 0
        while (j < live.size()) {
            val sub = live[j]
            if (!Sse.sendTo(sub.call, payload)) {
                Sse.drop(sub.call.conn.sock.fd)
            }
            j = j + 1
        }
    }

    fun drop(fd: Int) {
        sync(Sse.lock) {
            Sse.dropLocked(fd, true)
            true
        }
    }

    fun dropLocked(fd: Int, closeIt: Bool) {
        var i = 0
        while (i < Sse.subs.size()) {
            if (Sse.subs[i].call.conn.sock.fd == fd) {
                val sub = Sse.subs[i]
                Sse.subs.remove(i)
                if (closeIt) {
                    try {
                        sub.call.conn.close()
                    } catch (e: Throwable) {
                    }
                }
                return
            }
            i = i + 1
        }
    }
}
