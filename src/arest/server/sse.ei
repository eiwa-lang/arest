import { ApplicationCall } from ".arest.server.application_call"
import { MutableList } from "std.collections"
import { Mutex, sync } from "std.thread"
import { sleepMs } from "std.time"

// Server-Sent Events over Transfer-Encoding: chunked (RFC 9112 §7.1).
//
// Raw framing lives here (not in std.http) so no toolchain rebuild is
// needed: the socket is written directly. A handler hijacks its
// connection with startSse(), pushes frames with sendSse*(), and MUST
// finish with closeSse() — the dispatcher will not close a hijacked
// connection.

// Chunk size in lowercase hex without leading zeros ("0" for 0).
fun chunkSizeHex(value: Int): String {
    val digits = "0123456789abcdef"
    if (value == 0) {
        return "0"
    }
    var hex = ""
    var rest = value
    while (rest > 0) {
        val d = rest - (rest / 16) * 16
        hex = digits.substring(d, d + 1) + hex
        rest = rest / 16
    }
    return hex
}

// Hijacks the connection: writes SSE headers (200, text/event-stream,
// no-cache, chunked, keep-alive) plus any headers queued via
// responseHeader()/cookies, and marks the call so the dispatcher
// leaves the socket open.
fun ApplicationCall.startSse() {
    var head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n"
    var i = 0
    while (i < this.pendingHeaders.size()) {
        head = head + this.pendingHeaders.get(i) + "\r\n"
        i = i + 1
    }
    head = head + "\r\n"
    this.conn.sock.write(head)
    this.sseOpen = true
}

// One raw chunked frame.
fun ApplicationCall.sendChunk(data: String) {
    this.conn.sock.write("${chunkSizeHex(data.length)}\r\n$data\r\n")
}

// A single SSE message frame. `event` sets the named-event field,
// `id` sets the last-event-id field for client reconnects.
fun ApplicationCall.sendSse(data: String, event: String? = null, id: String? = null) {
    var payload = ""
    if (event != null) {
        payload = payload + "event: ${event}\n"
    }
    if (id != null) {
        payload = payload + "id: ${id}\n"
    }
    payload = payload + "data: $data\n\n"
    this.sendChunk(payload)
}

// SSE comment frame — a protocol-level heartbeat (EventSource ignores it).
fun ApplicationCall.sendSseComment(comment: String) {
    this.sendChunk(": $comment\n\n")
}

// Terminates the chunked stream and closes the socket.
fun ApplicationCall.closeSse() {
    this.conn.sock.write("0\r\n\r\n")
    this.conn.close()
}

// Shared hub for long-lived SSE streams.
//
// Rationale: a stream handler must NOT loop on its worker (each open
// EventSource would pin one worker thread; 10 reloads starve a 10-worker
// pool and every later request hangs). Instead the handler calls startSse()
// and returns at once, handing the socket to the hub. One cooperative pump
// task sends heartbeats; broadcasts fan out to every subscriber. Frame
// writes are serialized by writeLock; dead sockets are dropped on write
// failure (EventSource reconnects on its own).
type SseSubscription(val call: ApplicationCall)

object SseHub {
    val lock: Mutex = Mutex()
    val writeLock: Mutex = Mutex()
    val subs: MutableList<SseSubscription> = MutableList<SseSubscription>()
    var pumpStarted: Bool = false
    var pumpRunning: Bool = true
    var heartbeatMs: Int = 14000

    fun subscribe(call: ApplicationCall) {
        var start = false
        sync(SseHub.lock) {
            SseHub.subs.add(SseSubscription(call))
            if (!SseHub.pumpStarted) {
                SseHub.pumpStarted = true
                SseHub.pumpRunning = true
                start = true
            }
            true
        }
        if (start) {
            task {
                while (SseHub.pumpRunning) {
                    sleepMs(SseHub.heartbeatMs)
                    SseHub.heartbeat()
                }
            }
        }
    }

    fun unsubscribe(call: ApplicationCall) {
        sync(SseHub.lock) {
            SseHub.dropLocked(call.conn.sock.fd, true)
            true
        }
    }

    fun stop() {
        sync(SseHub.lock) {
            SseHub.pumpRunning = false
            SseHub.pumpStarted = false
            true
        }
    }

    fun count(): Int {
        var n = 0
        sync(SseHub.lock) {
            n = SseHub.subs.size()
            true
        }
        return n
    }

    fun broadcast(data: String, event: String? = null, id: String? = null) {
        var payload = ""
        if (event != null) {
            payload = payload + "event: ${event}\n"
        }
        if (id != null) {
            payload = payload + "id: ${id}\n"
        }
        payload = payload + "data: $data\n\n"
        SseHub.pushAll(payload)
    }

    fun heartbeat() {
        SseHub.pushAll(": hb\n\n")
    }

    fun pushAll(payload: String) {
        val frame = "${chunkSizeHex(payload.length)}\r\n$payload\r\n"
        val live: MutableList<SseSubscription> = MutableList<SseSubscription>()
        sync(SseHub.lock) {
            var i = 0
            while (i < SseHub.subs.size()) {
                live.add(SseHub.subs[i])
                i = i + 1
            }
            true
        }
        var j = 0
        while (j < live.size()) {
            val sub = live[j]
            if (!SseHub.pushOne(sub, frame)) {
                SseHub.drop(sub.call.conn.sock.fd)
            }
            j = j + 1
        }
    }

    fun pushOne(sub: SseSubscription, frame: String): Bool {
        var ok = false
        sync(SseHub.writeLock) {
            val n = sub.call.conn.sock.write(frame)
            ok = n == frame.length
            true
        }
        return ok
    }

    fun drop(fd: Int) {
        sync(SseHub.lock) {
            SseHub.dropLocked(fd, true)
            true
        }
    }

    fun dropLocked(fd: Int, closeIt: Bool) {
        var i = 0
        while (i < SseHub.subs.size()) {
            if (SseHub.subs[i].call.conn.sock.fd == fd) {
                val sub = SseHub.subs[i]
                SseHub.subs.remove(i)
                if (closeIt) {
                    try {
                        sub.call.conn.close()
                    } catch (e: Throwable) {
                    }
                }
                return
            }
            i = i + 1
        }
    }
}
