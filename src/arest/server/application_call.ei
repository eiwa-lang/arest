import { ServerConnection, Request } from "std.http"
import { Serializable } from "std.serde"
import { NativeMemory } from "std.core"
import { MutableMap, MutableList } from "std.collections"
import { ArestBuilder } from ".arest.server.arest_builder"
import { Cookies } from ".arest.server.cookies"

type ApplicationCall(
    val conn: ServerConnection,
    val request: Request,
    val server: ArestBuilder,
    val pathParams: MutableMap<String, String> = MutableMap<String, String>(),
    val pendingHeaders: MutableList<String> = MutableList<String>()
) {

    // Queues a raw response header line (e.g. "HX-Redirect: /home").
    // Flushed with the next respond* call.
    fun responseHeader(name: String, value: String) {
        pendingHeaders.add("$name: $value")
    }

    // Queues a Set-Cookie header. `attrs` is appended verbatim
    // (e.g. "; HttpOnly; Path=/; Max-Age=600").
    fun setCookie(name: String, value: String, attrs: String = "") {
        pendingHeaders.add("Set-Cookie: ${Cookies.build(name, value, attrs)}")
    }

    // Clears a cookie by expiring it immediately.
    fun clearCookie(name: String, path: String = "/") {
        pendingHeaders.add("Set-Cookie: ${Cookies.expired(name, path)}")
    }

    // Reads a cookie from the Cookie request header. Returns null when absent.
    fun cookie(name: String): String? {
        val header = header("Cookie")
        if (header == null) {
            return null
        }
        return Cookies.parse(header!!, name)
    }

    // 302 redirect with a Location header (htmx requests should use HX-Redirect instead).
    fun respondRedirect(url: String, status: Int = 302) {
        responseHeader("Location", url)
        respond("", status, "text/plain")
    }

    fun respond(body: String, status: Int, contentType: String) {
        conn.writeResponseWithHeaders(status, contentType, body, pendingHeaders.freeze())
    }

    fun respond(status: Int = 204) {
        conn.writeResponseWithHeaders(status, server.negotiation.contentType(), "", pendingHeaders.freeze())
    }

    fun respond(value: Serializable, status: Int = 200) {
        val body = server.negotiation.serialize(value)
        respond(body, status, server.negotiation.contentType())
    }

    fun <T> receive(): T {
        val serdeVal = this.server.negotiation.deserialize(this.request.body)
        return T.deserialize(serdeVal)
    }

    // Thin alias of receive<T>() for ergonomics. Both stay available.
    fun <T> body(): T {
        return this.receive<T>()
    }

    // Parses an application/x-www-form-urlencoded body (e.g. "a=1&b=2")
    // into a map, URL-decoding keys and values ("+" -> space, "%XX" -> byte).
    // Ktor equivalent: call.receiveParameters().
    fun formParams(): Map<String, String> {
        val map = MutableMap<String, String>()
        val raw = this.request.body
        if (raw == "") {
            return map
        }
        var rest = raw
        var searching = true
        while (searching) {
            val ampIdx = rest.indexOf("&")
            var pair = ""
            if (ampIdx >= 0) {
                pair = rest.substring(0, ampIdx)
                rest = rest.substring(ampIdx + 1, rest.length)
            } else {
                pair = rest
                searching = false
            }
            val eqIdx = pair.indexOf("=")
            if (eqIdx >= 0) {
                val k = urlDecode(pair.substring(0, eqIdx))
                val v = urlDecode(pair.substring(eqIdx + 1, pair.length))
                map.put(k, v)
            } else if (pair.length > 0) {
                map.put(urlDecode(pair), "")
            }
            if (rest.length == 0) {
                searching = false
            }
        }
        return map.freeze()
    }

    // Returns a single form field (String?) — null when absent.
    // e.g. body "param1=hello&param2=world" -> form("param1") == "hello"
    fun form(name: String): String? {
        return formParams().get(name)
    }

    fun respondText(body: String, status: Int = 200) {
        respond(body, status, "text/plain; charset=UTF-8")
    }

    fun respondHtml(body: String, status: Int = 200) {
        respond(body, status, "text/html; charset=UTF-8")
    }

    fun respondHtml(bodyContent: () -> String, status: Int = 200) {
        respond(bodyContent(), status, "text/html; charset=UTF-8")
    }

    fun respondJson(body: String, status: Int = 200) {
        respond(body, status, "application/json; charset=UTF-8")
    }

    fun header(name: String): String? {
        val direct = request.headers.get(name)
        if (direct != null) {
            return direct
        }
        var i = 0
        val entries = request.headers.entries
        while (i < entries.size()) {
            var curr = entries.get(i)
            while (curr != null) {
                if (iequals(curr!!.key, name)) {
                    return curr!!.value
                }
                curr = curr!!.next
            }
            i = i + 1
        }
        return null
    }

    fun query(name: String): String? {
        return request.queries.get(name)
    }

    // Returns the value of a path parameter extracted by the router.
    // e.g. for pattern "/users/:id" matched against "/users/42" -> pathParam("id") == "42"
    fun pathParam(name: String): String? {
        return pathParams.get(name)
    }

    // Decodes application/x-www-form-urlencoded (and query) encoding:
    // "+" -> space, "%XX" -> byte. Operates on raw bytes so UTF-8 works.
    fun urlDecode(s: String): String {
        val buf = Standard.gcMalloc(s.length + 1)
        var o = 0
        var i = 0
        while (i < s.length) {
            val b = NativeMemory.readByte(s.ptr!!, i)
            if (b == 43) {
                NativeMemory.writeByte(buf, o, 32)
                o = o + 1
                i = i + 1
            } else if (b == 37) {
                if (i + 2 < s.length) {
                    val h1 = hexVal(NativeMemory.readByte(s.ptr!!, i + 1))
                    val h2 = hexVal(NativeMemory.readByte(s.ptr!!, i + 2))
                    if (h1 >= 0 && h2 >= 0) {
                        NativeMemory.writeByte(buf, o, h1 * 16 + h2)
                        o = o + 1
                        i = i + 3
                    } else {
                        NativeMemory.writeByte(buf, o, b)
                        o = o + 1
                        i = i + 1
                    }
                } else {
                    NativeMemory.writeByte(buf, o, b)
                    o = o + 1
                    i = i + 1
                }
            } else {
                NativeMemory.writeByte(buf, o, b)
                o = o + 1
                i = i + 1
            }
        }
        NativeMemory.writeByte(buf, o, 0)
        return String(buf, o)
    }

    fun hexVal(c: Int): Int {
        if (c >= 48 && c <= 57) {
            return c - 48
        }
        if (c >= 65 && c <= 70) {
            return c - 55
        }
        if (c >= 97 && c <= 102) {
            return c - 87
        }
        return -1
    }

    fun iequals(a: String, b: String): Bool {
        if (a.length != b.length) {
            return false
        }
        var i = 0
        while (i < a.length) {
            var ca = NativeMemory.readByte(a.ptr!!, i)
            var cb = NativeMemory.readByte(b.ptr!!, i)
            if (ca >= 65 && ca <= 90) {
                ca = ca + 32
            }
            if (cb >= 65 && cb <= 90) {
                cb = cb + 32
            }
            if (ca != cb) {
                return false
            }
            i = i + 1
        }
        return true
    }
}
