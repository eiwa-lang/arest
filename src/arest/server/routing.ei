import { MutableMap } from "std.collections"
import { ApplicationCall } from ".arest.server.application_call"

// Holds the matched route together with the extracted path parameters.
type RouteMatch(
    val route: Route,
    val pathParams: MutableMap<String, String>
)

type Route(
    val method: String,
    val pattern: String,
    val handler: ApplicationCall.(ApplicationCall) -> Void
)

type StaticConfig(
    val prefix: String,
    val dir: String
)

type RoutingBuilder(
    val routes: MutableList<Route?> = MutableList<Route?>(),
    val staticRoutes: MutableList<StaticConfig?> = MutableList<StaticConfig?>(),
    var groupPrefix: String = ""
) {

    // Groups routes under a common prefix, e.g.:
    // group("/user") { get("/list") { ... } get("me") { ... } }
    // Supports nesting: group("/api") { group("v1") { get("/users") { ... } } }
    fun group(prefix: String, init: RoutingBuilder.() -> Void) {
        val prev = this.groupPrefix
        this.groupPrefix = joinPrefix(prev, prefix)
        init(this)
        this.groupPrefix = prev
    }

    fun get(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("GET", joinPrefix(this.groupPrefix, path), handler))
    }

    fun post(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("POST", joinPrefix(this.groupPrefix, path), handler))
    }

    fun put(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("PUT", joinPrefix(this.groupPrefix, path), handler))
    }

    fun patch(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("PATCH", joinPrefix(this.groupPrefix, path), handler))
    }

    fun delete(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("DELETE", joinPrefix(this.groupPrefix, path), handler))
    }

    fun head(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("HEAD", joinPrefix(this.groupPrefix, path), handler))
    }

    fun options(path: String, handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("OPTIONS", joinPrefix(this.groupPrefix, path), handler))
    }

    // Shorthand without path: uses the current group prefix itself.
    // group("user") { get { ... } } -> GET /user
    // Outside any group, get { ... } -> GET /
    fun get(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("GET", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun post(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("POST", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun put(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("PUT", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun patch(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("PATCH", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun delete(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("DELETE", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun head(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("HEAD", joinPrefix(this.groupPrefix, "/"), handler))
    }

    fun options(handler: ApplicationCall.(ApplicationCall) -> Void) {
        routes.add(Route("OPTIONS", joinPrefix(this.groupPrefix, "/"), handler))
    }

    // Returns a RouteMatch if the given method+path matches this route list,
    // preferring exact (static) routes over parametric ones.
    fun match(method: String, path: String): RouteMatch? {
        var parametric: RouteMatch? = null
        var i = 0
        while (i < routes.size()) {
            val r = routes.get(i)
            if (r is Route) {
                val route = r
                if (route.method == method) {
                    val params = matchPattern(route.pattern, path)
                    if (params != null) {
                        val isExact = route.pattern == path
                        if (isExact) {
                            return RouteMatch(route, params!!)
                        }
                        if (parametric == null) {
                            parametric = RouteMatch(route, params!!)
                        }
                    }
                }
            }
            i = i + 1
        }
        return parametric
    }

    // Matches a pattern like "/users/:id/posts/:postId" against a concrete path.
    // Returns a filled MutableMap on success, null on mismatch.
    fun matchPattern(pattern: String, path: String): MutableMap<String, String>? {
        val params = MutableMap<String, String>()
        val pSegs = splitPath(pattern)
        val uSegs = splitPath(path)
        if (pSegs.size() != uSegs.size()) {
            return null
        }
        var i = 0
        while (i < pSegs.size()) {
            val ps = pSegs.get(i)
            val us = uSegs.get(i)
            if (ps is String && us is String) {
                val p = ps!!
                val u = us!!
                if (p.startsWith(":")) {
                    val name = p.substring(1, p.length)
                    params.put(name, u)
                } else if (p.startsWith("{") && p.endsWith("}")) {
                    val name = p.substring(1, p.length - 1)
                    params.put(name, u)
                } else if (p != u) {
                    return null
                }
            }
            i = i + 1
        }
        return params
    }

    // Splits "/a/b/c" into ["a", "b", "c"], stripping leading slash.
    fun splitPath(path: String): MutableList<String?> {
        val segs = MutableList<String?>()
        var start = 0
        var i = 0
        val p = if (path.startsWith("/")) path.substring(1, path.length) else path
        while (i <= p.length) {
            if (i == p.length) {
                if (i > start) {
                    segs.add(p.substring(start, i))
                }
                i = i + 1
            } else {
                val c = p.charAt(i)
                if (c == "/") {
                    segs.add(p.substring(start, i))
                    start = i + 1
                    i = i + 1
                } else {
                    i = i + 1
                }
            }
        }
        return segs
    }

    // Joins a group prefix with a route path, normalizing slashes.
    // joinPrefix("/user", "me") -> "/user/me"
    // joinPrefix("/user", "/me") -> "/user/me"
    // joinPrefix("", "/hello") -> "/hello"
    // joinPrefix("/api", "/") -> "/api"
    fun joinPrefix(base: String, rel: String): String {
        var b = base
        if (b == "/") {
            b = ""
        } else if (b.endsWith("/") && b.length > 1) {
            b = b.substring(0, b.length - 1)
        }
        if (rel == "" || rel == "/") {
            if (b == "") {
                return "/"
            }
            return b
        }
        var r = rel
        if (!r.startsWith("/")) {
            r = "/$r"
        }
        if (b == "") {
            return r
        }
        return "$b$r"
    }

    fun static(prefix: String, dir: String) {
        staticRoutes.add(StaticConfig(joinPrefix(this.groupPrefix, prefix), dir))
    }
}
