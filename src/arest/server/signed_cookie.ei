import { Serializable, SerdeValue } from "std.serde"
import { serializeJson, parseJsonToSerde } from "std.json"
import { NativeMemory } from "std.core"
import { Crypto } from "crypto.crypto"
import { Encoding } from "crypto.encoding"
import { ApplicationCall } from ".arest.server.application_call"

// Signed cookies for arest: v1.<base64url(json)>.<hmacHex("v1." + b64, secret)>
//
// Crypto stays in the crypto lib (HMAC/base64url); this module owns only the
// cookie transport: format, constant-time compare, and Set-Cookie attributes.
object SignedCookie {

    fun secureEquals(a: String, b: String): Bool {
        if (a.length != b.length) {
            return false
        }
        var diff = 0
        var i = 0
        while (i < a.length) {
            val ca = NativeMemory.readByte(a.ptr!!, i)
            val cb = NativeMemory.readByte(b.ptr!!, i)
            // No early return: always scan the full string so comparison
            // time does not reveal the mismatch position.
            if (ca != cb) {
                diff = diff + 1
            }
            i = i + 1
        }
        return diff == 0
    }

    fun signPayload(b64: String, secret: String): String {
        val data = "v1.$b64"
        return "$data.${Crypto.hmacSha256Hex(data, secret)}"
    }

    fun verifySignedValue(signed: String, secret: String): String? {
        // split on last '.' -> data="v1.b64", sig=hmac
        var lastDot = -1
        var i = 0
        while (i < signed.length) {
            if (signed.substring(i, i + 1) == ".") {
                lastDot = i
            }
            i = i + 1
        }
        if (lastDot == -1) {
            return null
        }
        val data = signed.substring(0, lastDot)
        val sig = signed.substring(lastDot + 1, signed.length)
        if (data.length < 3 || data.substring(0, 3) != "v1.") {
            return null
        }
        val expected = Crypto.hmacSha256Hex(data, secret)
        if (!SignedCookie.secureEquals(sig, expected)) {
            return null
        }
        return data.substring(3, data.length)
    }

    fun encode(payload: Serializable): String {
        return Encoding.base64UrlNoPadding(serializeJson(payload))
    }

    fun <T> decode(b64: String): T {
        val json = Encoding.base64UrlDecode(b64)
        val serdeVal: SerdeValue = parseJsonToSerde(json)
        return T.deserialize(serdeVal)
    }

    fun setSignedCookie(call: ApplicationCall, name: String, payload: Serializable, secret: String, maxAge: Int = 2592000, path: String = "/", httpOnly: Bool = true, secure: Bool = true, sameSite: String = "Lax") {
        val signed = SignedCookie.signPayload(SignedCookie.encode(payload), secret)
        var attrs = "; Path=$path; Max-Age=$maxAge; SameSite=$sameSite"
        if (httpOnly) {
            attrs = "$attrs; HttpOnly"
        }
        if (secure) {
            attrs = "$attrs; Secure"
        }
        call.setCookie(name, signed, attrs)
    }

    fun <T> getSignedCookie(call: ApplicationCall, name: String, secret: String): T? {
        val raw = call.cookie(name)
        if (raw == null) {
            return null
        }
        val b64 = SignedCookie.verifySignedValue(raw!!, secret)
        if (b64 == null) {
            return null
        }
        return SignedCookie.decode<T>(b64!!)
    }
}
